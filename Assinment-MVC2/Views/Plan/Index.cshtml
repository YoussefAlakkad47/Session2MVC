@model IEnumerable<Assinment_MVC2.Models.Plan>
@{
    ViewData["Title"] = "Plans";
}

@if (TempData["SuccessMessage"] is not null)
{
    <div id="Alert" class="alert alert-success flash">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] is not null)
{
    <div id="Alert" class="alert alert-danger flash">@TempData["ErrorMessage"]</div>
}

<h1 class="page-title">Plans</h1>
<p class="page-sub">What members can subscribe to. Plans are seeded from plans.json.</p>

<div class="lock-note">
    <span class="lock-bar"></span>
    <i class="bi bi-shield-check"></i>
    <div>
        A plan with <strong>active or upcoming memberships</strong> is locked: it can't be edited or deactivated until those memberships end. Inactive plans can't be sold or edited.
    </div>
</div>

@if (!Model.Any())
{
    <p class="empty-plans">No plans yet</p>
}
else
{
    <div class="plan-grid">
        @foreach (var plan in Model)
        {
            <article class="plan-tile">
                <div class="plan-tile-head">
                    <h2>@plan.Name</h2>
                    @if (plan.IsActive)
                    {
                        <span class="status on"><i></i> Active</span>
                    }
                    else
                    {
                        <span class="status off"><i></i> Inactive</span>
                    }
                </div>
                <div class="plan-price">
                    <strong>@plan.Price.ToString("N0")</strong>
                    <span>EGP</span>
                </div>
                <p class="plan-meta">
                    <i class="bi bi-calendar3"></i>
                    @plan.DurationDays days
                </p>
                <p class="plan-desc">@plan.Description</p>
                <div class="plan-actions">
                    @if (plan.IsActive)
                    {
                        <a class="btn-edit" asp-action="Edit" asp-route-id="@plan.Id">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <form asp-action="Activate" asp-route-id="@plan.Id" method="post">
                            <button type="submit" class="btn-off">
                                <i class="bi bi-slash-circle"></i> Deactivate
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Activate" asp-route-id="@plan.Id" method="post">
                            <button type="submit" class="btn-on">
                                <i class="bi bi-check-circle"></i> Activate
                            </button>
                        </form>
                    }
                </div>
            </article>
        }
    </div>
}
