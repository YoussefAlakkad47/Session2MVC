<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gym</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Assinment_MVC2.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/route.css" asp-append-version="true" />
</head>
<body class="app-shell">
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        var pageTitle = ViewData["Title"]?.ToString() ?? "Dashboard";
    }
    <aside class="sidebar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <span class="brand-mark">R</span>
            <span>
                <strong>ROUTE</strong>
                <small>Gym Management</small>
            </span>
        </a>
        <nav class="side-nav">
            <div class="side-label">OVERVIEW</div>
            <a class="side-link @(controller == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                <i class="bi bi-grid"></i> Dashboard
            </a>
            <div class="side-label">PEOPLE</div>
            <a class="side-link @(controller == "Member" ? "active" : "")" asp-controller="Member" asp-action="Index">
                <i class="bi bi-people"></i> Members
            </a>
            <a class="side-link @(controller == "Trainer" ? "active" : "")" asp-controller="Trainer" asp-action="Index">
                <i class="bi bi-person"></i> Trainers
            </a>
            <div class="side-label">GYM</div>
            <a class="side-link @(controller == "Plan" ? "active" : "")" asp-controller="Plan" asp-action="Index">
                <i class="bi bi-bullseye"></i> Plans
            </a>
            <a class="side-link @(controller == "Membership" ? "active" : "")" asp-controller="Membership" asp-action="Index">
                <i class="bi bi-person-vcard"></i> Memberships
            </a>
            <a class="side-link @(controller == "Session" ? "active" : "")" asp-controller="Session" asp-action="Index">
                <i class="bi bi-calendar-event"></i> Sessions
            </a>
        </nav>
        <div class="side-foot">
            <span>.NET Track</span>
            <span>Route Academy</span>
        </div>
    </aside>
    <div class="workspace">
        <header class="topbar">
            <div class="crumb">
                <a asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i></a>
                <span>/</span>
                <span>@pageTitle</span>
            </div>
            <div class="date-pill">
                <i class="bi bi-calendar3"></i>
                @DateTime.Now.ToString("dddd, d MMM yyyy")
            </div>
        </header>
        <main class="page">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
